[Unit]
Description=Collateral Caching Service (CCS)
Documentation=https://github.com/intel/confidential-computing.tee.dcap.ccs/blob/main/service/README.md
After=network.target

[Service]
Type=simple
User=ccs
WorkingDirectory=/opt/intel/sgx-dcap-ccs/
EnvironmentFile=-/etc/environment
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/intel/sgx-dcap-ccs/ccs_server.js
Restart=on-failure
RestartSec=15s
MemoryMax=1G
MemoryHigh=512M

[Install]
WantedBy=multi-user.target
