#!/usr/bin/env bash
# postinst script for sgx-dcap-ccs
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

PACKAGE_PATH=@pkg_path@
LEGACY_PACKAGE_PATH=@legacy_pkg_path@
SERVICE_USER=ccs
SERVICE_GROUP=ccs
LEGACY_SERVICE_USER=pccs
LEGACY_SERVICE_GROUP=pccs

copy_legacy_dir_contents() {
    SOURCE_DIR="$1"
    TARGET_DIR="$2"

    if [ -d "${SOURCE_DIR}" ]; then
        mkdir -p "${TARGET_DIR}"
        cp -a "${SOURCE_DIR}/." "${TARGET_DIR}/" 2>/dev/null || true
    fi
}

migrate_legacy_state() {
    if [ "${PACKAGE_PATH}" = "${LEGACY_PACKAGE_PATH}" ] || [ ! -d "${LEGACY_PACKAGE_PATH}" ]; then
        return
    fi

    mkdir -p "${PACKAGE_PATH}/config" "${PACKAGE_PATH}/ssl_key"

    copy_legacy_dir_contents "${LEGACY_PACKAGE_PATH}/config" "${PACKAGE_PATH}/config"

    if [ -f "${LEGACY_PACKAGE_PATH}/pckcache.db" ]; then
        cp -f "${LEGACY_PACKAGE_PATH}/pckcache.db" "${PACKAGE_PATH}/pckcache.db"
    fi

    copy_legacy_dir_contents "${LEGACY_PACKAGE_PATH}/ssl_key" "${PACKAGE_PATH}/ssl_key"

    rm -rf "${LEGACY_PACKAGE_PATH}/node_modules"
    rm -f "${LEGACY_PACKAGE_PATH}/.npmrc"
    rm -rf "${LEGACY_PACKAGE_PATH}/.npm"
}

normalize_service_ownership() {
    if [ ! "$(getent passwd "${SERVICE_USER}")" -o ! "$(getent group "${SERVICE_GROUP}")" ]; then
        return
    fi

    for d in config ssl_key; do
        if [ -d "${PACKAGE_PATH}/${d}" ]; then
            chown -R "${SERVICE_USER}:${SERVICE_GROUP}" "${PACKAGE_PATH}/${d}"
        fi
    done

    if [ -f "${PACKAGE_PATH}/pckcache.db" ]; then
        chown "${SERVICE_USER}:${SERVICE_GROUP}" "${PACKAGE_PATH}/pckcache.db"
    fi
}

cleanup_legacy_service_account() {
    if [ "${PACKAGE_PATH}" = "${LEGACY_PACKAGE_PATH}" ]; then
        return
    fi

    if getent passwd "${LEGACY_SERVICE_USER}" >/dev/null 2>&1; then
        if command -v deluser >/dev/null 2>&1; then
            deluser --quiet --system "${LEGACY_SERVICE_USER}" || true
        else
            userdel "${LEGACY_SERVICE_USER}" || true
        fi
    fi

    if getent group "${LEGACY_SERVICE_GROUP}" >/dev/null 2>&1; then
        if command -v delgroup >/dev/null 2>&1; then
            delgroup --quiet --system "${LEGACY_SERVICE_GROUP}" || true
        else
            groupdel "${LEGACY_SERVICE_GROUP}" || true
        fi
    fi
}

case "$1" in
    configure)
        migrate_legacy_state
        cleanup_legacy_service_account
        normalize_service_ownership
        if [ -x ${PACKAGE_PATH}/startup.sh ]; then ${PACKAGE_PATH}/startup.sh debian; fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
