#!/usr/bin/env bash
# postrm script for sgx-dcap-ccs
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postrm> `remove'
#        * <postrm> `purge'
#        * <old-postrm> `upgrade' <new-version>
#        * <disappearer's-postrm> `disappear' <overwriter> <new-version>
#        * <new-postrm> `failed-upgrade' <old-version>
#        * <new-postrm> `abort-install'
#        * <new-postrm> `abort-install' <old-version>
#        * <new-postrm> `abort-upgrade' <old-version>
#        * <disappearer's-postrm> `abort-disappear' <overwriter> <new-version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

PACKAGE_PATH=@pkg_path@
SERVICE_USER=ccs
SERVICE_GROUP=ccs

remove_npm_artifacts() {
    echo "Removing npm artifacts"
    rm -rf "${PACKAGE_PATH}/node_modules"
    rm -f  "${PACKAGE_PATH}/.npmrc"
    rm -rf "${PACKAGE_PATH}/.npm"
}

remove_service_data() {
    echo "Removing service data"
    rm -f  "${PACKAGE_PATH}/pckcache.db"
    rm -rf "${PACKAGE_PATH}/logs"
    rm -rf "${PACKAGE_PATH}/ssl_key"
    rm -rf "${PACKAGE_PATH}/config"
    rmdir  "${PACKAGE_PATH}" 2>/dev/null || true
}

remove_service_account() {
    if getent passwd "${SERVICE_USER}" >/dev/null 2>&1; then
        echo "Removing service user '${SERVICE_USER}'..."
        if command -v deluser >/dev/null 2>&1; then
            deluser --quiet --system "${SERVICE_USER}" || true
        else
            userdel "${SERVICE_USER}" || true
        fi
    fi

    if getent group "${SERVICE_GROUP}" >/dev/null 2>&1; then
        echo "Removing service group '${SERVICE_GROUP}'..."
        if command -v delgroup >/dev/null 2>&1; then
            delgroup --quiet --system "${SERVICE_GROUP}" || true
        else
            groupdel "${SERVICE_GROUP}" || true
        fi
    fi
}

purge_service_state() {
    remove_npm_artifacts
    remove_service_data
    remove_service_account
}

case "$1" in
    purge)
        purge_service_state
    ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
